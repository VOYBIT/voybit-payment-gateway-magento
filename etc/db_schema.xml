<?xml version="1.0"?>
<schema xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:Setup/Declaration/Schema/etc/schema.xsd">
    <table name="voybit_payment_gateway_order" resource="default" engine="innodb" comment="Voybit payment for a Magento order">
        <column xsi:type="varchar" name="payment_id" nullable="false" length="36" comment="Voybit payment id"/>
        <column xsi:type="int" name="order_id" unsigned="true" nullable="false" comment="Sales order id"/>
        <column xsi:type="varchar" name="public_id" nullable="false" length="22" comment="Voybit public id"/>
        <column xsi:type="varchar" name="checkout_url" nullable="false" length="64" comment="Hosted checkout URL"/>
        <constraint xsi:type="primary" referenceId="PRIMARY">
            <column name="payment_id"/>
        </constraint>
        <constraint xsi:type="unique" referenceId="VOYBIT_PAYMENT_GATEWAY_ORDER_ORDER">
            <column name="order_id"/>
        </constraint>
        <constraint xsi:type="foreign" referenceId="VOYBIT_PAYMENT_GATEWAY_ORDER_SALES" table="voybit_payment_gateway_order" column="order_id" referenceTable="sales_order" referenceColumn="entity_id" onDelete="CASCADE"/>
    </table>
    <table name="voybit_payment_gateway_delivery" resource="default" engine="innodb" comment="Processed Voybit webhook deliveries">
        <column xsi:type="varchar" name="webhook_id" nullable="false" length="64" comment="Webhook delivery id"/>
        <column xsi:type="timestamp" name="received_at" on_update="false" nullable="false" default="CURRENT_TIMESTAMP" comment="When the delivery was accepted"/>
        <constraint xsi:type="primary" referenceId="PRIMARY">
            <column name="webhook_id"/>
        </constraint>
    </table>
</schema>
