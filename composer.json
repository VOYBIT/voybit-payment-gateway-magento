{
  "name": "voybit/payment-gateway-magento",
  "description": "Magento 2 payment method for the Voybit crypto payment gateway.",
  "type": "magento2-module",
  "license": "MIT",
  "require": {
    "php": ">=8.1",
    "voybit/payment-gateway": "dev-main",
    "magento/framework": "^103.0",
    "magento/module-checkout": "^100.4",
    "magento/module-config": "^101.2",
    "magento/module-payment": "^100.4",
    "magento/module-quote": "^101.2",
    "magento/module-sales": "^103.0",
    "magento/module-store": "^101.1"
  },
  "repositories": [
    {
      "type": "vcs",
      "url": "https://github.com/VOYBIT/voybit-payment-gateway-php"
    }
  ],
  "autoload": {
    "files": [
      "registration.php"
    ],
    "psr-4": {
      "Voybit\\PaymentGateway\\Magento\\": ""
    }
  },
  "minimum-stability": "dev",
  "prefer-stable": true
}
